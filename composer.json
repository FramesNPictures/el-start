{
    "name": "framesnpictures/el-start",
    "description": "Opinionated Laravel Start Package",
    "type": "library",
    "authors": [
        {
            "name": "Chris Cynarski",
            "email": "chris@cynarski.net"
        }
    ],
    "require": {
        "ext-sodium": "*",
        "framesnpictures/el-module": ">=v1.0"
    },
    "autoload": {
        "psr-4": {
            "Fnp\\ElStart\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Fnp\\ElStart\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fnp\\ElStart\\ElStartModule"
            ]
        }
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^3.8"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
